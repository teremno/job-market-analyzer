# Normalize line endings across Windows/Linux/macOS.
* text=auto

# Source files always LF so containers and shell scripts work everywhere.
*.py text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.toml text eol=lf
*.json text eol=lf
*.md text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.css text eol=lf
Dockerfile text eol=lf
.env.production.example text eol=lf

# Windows-only files keep CRLF.
*.ps1 text eol=crlf
*.bat text eol=crlf

# Binaries.
*.sqlite3 binary
*.png binary
*.svg text
